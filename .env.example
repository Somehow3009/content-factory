# --- Database (Neon/Supabase Postgres prod, sqlite local) ---
DATABASE_URL=sqlite:///./content_factory.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/content_factory

# --- Storage (R2 prod S3-compatible, MinIO local) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=content-factory
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=

# --- Security ---
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64==
API_WORKER_TOKEN=CHANGE_ME_WORKER_TOKEN
SECRET_KEY=CHANGE_ME

# --- OAuth ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- AI (abstraction, free-tier default) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# --- TTS (edge-tts free default, swap via interface) ---
TTS_PROVIDER=edge-tts
TTS_MODEL=vi-VN-HoaiMyNeural
TTS_API_KEY=

# --- Budgets / guards (§45: chặn chọn tràn lan + vượt render) ---
MONTHLY_COMPUTE_BUDGET=0
MONTHLY_AI_BUDGET=20
MAX_RENDER_JOBS_PER_DAY=20
MAX_JOBS_PER_SOURCE_PER_HOUR=30
MAX_SELECTED_PER_SOURCE_PER_DAY=3
STORAGE_FORCE_LOCAL=0
